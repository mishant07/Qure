API_PORT=8000
FRONTEND_URL=http://localhost:5173,http://localhost:4173
VITE_API_URL=http://localhost:8000
# API_KEY unset = open demo mode. Set it to lock the API (X-API-Key required,
# /docs off). CORS origins come from FRONTEND_URL above.
API_KEY=
MAX_UPLOAD_MB=5
RATE_LIMIT_PER_MIN=120
MLFLOW_TRACKING_URI=./mlruns
QUBITS=8
SHOTS=512
# RAG explanation layer (extractive only, offline). RAG_ENABLED=0 restores
# the legacy static-curated evidence path exactly.
RAG_ENABLED=1
RAG_TOP_K=3
